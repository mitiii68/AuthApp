@using AuthApp.Models
@model AuthApp.Models.Project
@{
    bool isEdit = Model.Id != 0;
    bool isAdmin = Context.Session.GetString("UserRole") == "Admin";
    ViewData["Title"] = isEdit ? "Редактирование проекта" : "Создание проекта";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .cs-wrap { position: relative; width: 100%; }

    .cs-trigger {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        width: 100%; min-height: 38px; padding: 6px 12px;
        border: 1px solid #d2d6de; border-radius: 4px;
        background: #fff; cursor: pointer; font-size: 14px; color: #333;
        transition: border-color .15s, box-shadow .15s; user-select: none;
    }
    .cs-trigger:hover { border-color: #aaa; }
    .cs-wrap.cs-open .cs-trigger { border-color: #3c8dbc; box-shadow: 0 0 0 2px rgba(60,141,188,.2); }
    .cs-trigger-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cs-arrow { flex-shrink: 0; color: #999; transition: transform .2s; }
    .cs-wrap.cs-open .cs-arrow { transform: rotate(180deg); }

    .cs-dropdown {
        display: none; position: absolute; top: calc(100% + 2px); left: 0; right: 0;
        z-index: 9999; background: #fff; border: 1px solid #d2d6de;
        border-radius: 4px; box-shadow: 0 4px 16px rgba(0,0,0,.15); overflow: hidden;
    }
    .cs-wrap.cs-open .cs-dropdown { display: block; }

    .cs-search-wrap { padding: 8px; border-bottom: 1px solid #eee; }
    .cs-search {
        width: 100%; padding: 6px 10px; border: 1px solid #d2d6de;
        border-radius: 3px; font-size: 13px; outline: none;
    }
    .cs-search:focus { border-color: #3c8dbc; }

    .cs-list { max-height: 220px; overflow-y: auto; }
    .cs-option { padding: 8px 12px; font-size: 13px; color: #333; cursor: pointer; transition: background .1s; }
    .cs-option:hover { background: #f4f6f9; }
    .cs-option.cs-selected { background: #e8f4fd; font-weight: 600; }
    .cs-option.cs-placeholder { color: #aaa; }
    .cs-option.cs-no-results { color: #aaa; text-align: center; padding: 16px; cursor: default; }
    .cs-option.cs-loading { color: #aaa; text-align: center; padding: 12px; cursor: default; }

    
    .contract-search-wrap {
        position: relative;
    }
    .contract-search-input {
        width: 100%;
        border: 1px solid #d2d6de;
        border-radius: 4px 0 0 4px;
        padding: 8px 12px;
        font-size: 14px;
        outline: none;
        transition: border-color .15s;
    }
    .contract-search-input:focus { border-color: #3c8dbc; }

    .contract-results {
        border: 1px solid #d2d6de;
        border-top: none;
        border-radius: 0 0 4px 4px;
        max-height: 240px;
        overflow-y: auto;
        background: #fff;
        display: none;
    }
    .contract-results.open { display: block; }
    .contract-result-item {
        padding: 10px 14px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        transition: background .1s;
        font-size: 13px;
    }
    .contract-result-item:last-child { border-bottom: none; }
    .contract-result-item:hover { background: #f4f6f9; }
    .contract-result-item .cn { font-weight: 600; color: #1a1a2e; }
    .contract-result-item .cs { color: #888; font-size: 12px; margin-top: 2px; }
</style>

<section class="content-header">
   
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Главная</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Проекты</a></li>
                    <li class="breadcrumb-item active">@(isEdit ? "Редактирование" : "Создание")</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
@if (TempData["DebugErrors"] != null)
{
    <div class="alert alert-danger mx-3 mt-2">
        <strong>Ошибки валидации:</strong> @TempData["DebugErrors"]
    </div>
}
    @if (TempData["DebugErrors"] != null)
    {
        <div class="alert alert-danger mx-3 mt-2">
            <strong>Ошибки валидации:</strong> @TempData["DebugErrors"]
        </div>
    }
    <div class="container-fluid">

        <ul class="nav nav-tabs mb-0" id="projectTabs">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabInfo" href="#">
                    <i class="fas fa-info-circle me-1"></i>Общая информация
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" data-bs-target="#tabContracts" href="#" id="contractsTabLink">
                    <i class="fas fa-file-contract me-1"></i>Договоры
                    <span class="badge bg-secondary ms-1" id="contractCount">@Model.ProjectContracts.Count</span>
                </a>
            </li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane fade show active" id="tabInfo">
                <div class="card card-outline card-primary" style="border-top-left-radius:0">
                    <div class="card-header">
                        <h3 class="card-title">Общая информация</h3>
                    </div>

                    @if (!isAdmin)
                    {
                        <div class="alert alert-info mx-3 mt-3 mb-0" style="border-radius:8px;font-size:14px">
                            <i class="fas fa-eye me-2"></i>Режим просмотра — редактирование недоступно
                        </div>
                    }

                    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" id="projectForm">
                        @Html.AntiForgeryToken()
                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="CreatedAt" />
                        }

                        <div class="card-body">
                            <div class="row">
                                <div class="col-12"><div asp-validation-summary="All" class="alert alert-danger py-2 small"></div></div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Name">Наименование проекта <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="form-control" placeholder="Введите наименование" readonly="@(!isAdmin)">
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Team">Команда проекта <span class="text-danger">*</span></label>
                                    <input asp-for="Team" class="form-control" placeholder="Введите команду" readonly="@(!isAdmin)">
                                    <span asp-validation-for="Team" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Budget">Сумма (бюджет)</label>
                                    <input asp-for="Budget" type="number" step="0.01" min="0"
                                           class="form-control" placeholder="Введите сумму" readonly="@(!isAdmin)">
                                    <span asp-validation-for="Budget" class="text-danger small"></span>
                                </div>

                                <div class="col-12 form-group">
                                    <label asp-for="Description">Описание <span class="text-danger">*</span></label>
                                    <textarea asp-for="Description" class="form-control" rows="3"
                                              placeholder="Введите описание проекта" readonly="@(!isAdmin)"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Status">Статус <span class="text-danger">*</span></label>
                                    <select asp-for="Status" class="form-control" disabled="@(!isAdmin)"
                                            asp-items='@(new SelectList(new[] {
                                                "На стадии идеи","Разработка бюджета и КП","Бюджет утвержден",
                                                "Объявлены закупки","Договор на согласовании","На регистрации","Выполняется","Завершен"
                                            }))'>
                                        <option value="">Выберите опцию</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="ProjectGroup">Группа проектов</label>
                                    <div class="input-group">
                                        <input asp-for="ProjectGroup" class="form-control" id="ProjectGroup"
                                               placeholder="Введите или выберите группу" autocomplete="off" readonly="@(!isAdmin)">
                                        @if (isAdmin)
                                        {
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-secondary"
                                                        onclick="openModal('modalProjectGroups')"
                                                        title="Выбрать из существующих">
                                                    <i class="fas fa-list"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="ResponsiblePerson">Ответственный <span class="text-danger">*</span></label>
                                    <select asp-for="ResponsiblePerson" class="form-control" disabled="@(!isAdmin)">
                                        <option value="">Выберите значение</option>
                                        @if (ViewBag.Users != null)
                                        {
                                            foreach (var u in (List<string>)ViewBag.Users)
                                            {
                                                if (Model.ResponsiblePerson == u)
                                                {
                                                    <option value="@u" selected>@u</option>
                                                }
                                                else
                                                {
                                                    <option value="@u">@u</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="ResponsiblePerson" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="StartDate">Дата начала <span class="text-danger">*</span></label>
                                    <div class="input-group date">
                                        @{ var startVal = Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : ""; }
                                        <input asp-for="StartDate" id="StartDate" type="date" class="form-control" value="@startVal" readonly="@(!isAdmin)">
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="ActualEndDate">Фактическая дата завершения</label>
                                    <div class="input-group date">
                                        @{ var actualVal = Model.ActualEndDate.HasValue ? Model.ActualEndDate.Value.ToString("yyyy-MM-dd") : ""; }
                                        <input asp-for="ActualEndDate" id="ActualEndDate" type="date" class="form-control" value="@actualVal" readonly="@(!isAdmin)">
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Contractors">Контрагенты <span class="text-danger">*</span></label>
                                    <input type="hidden" asp-for="Contractors" id="ContractorsHidden" />
                                    @if (isAdmin)
                                    {
                                        <div class="cs-wrap" id="cpWrap">
                                            <div class="cs-trigger" id="cpTrigger">
                                                <span class="cs-trigger-text" id="cpDisplay">
                                                    @(string.IsNullOrEmpty(Model.Contractors)
                                                        ? "— Выберите контрагента —"
                                                        : Model.Contractors)
                                                </span>
                                                <i class="fas fa-chevron-down cs-arrow"></i>
                                            </div>
                                            <div class="cs-dropdown" id="cpDropdown">
                                                <div class="cs-search-wrap">
                                                    <input type="text" class="cs-search" id="cpSearch"
                                                           placeholder="Поиск по названию...">
                                                </div>
                                                <div class="cs-list" id="cpList">
                                                    <div class="cs-option cs-loading">
                                                        <i class="fas fa-spinner fa-spin me-1"></i> Загрузка...
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control" value="@Model.Contractors" readonly>
                                    }
                                    <span asp-validation-for="Contractors" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="InterestSource">Источник интереса <span class="text-danger">*</span></label>
                                    <select asp-for="InterestSource" class="form-control" disabled="@(!isAdmin)"
                                            asp-items='@(new SelectList(new[] {
                                                "Постоянный клиент","Самопроизвольный","Сотрудник","Партнер"
                                            }))'>
                                        <option value="">Выберите опцию</option>
                                    </select>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Employee">Сотрудник</label>
                                    <select asp-for="Employee" class="form-control" disabled="@(!isAdmin)">
                                        <option value="">Выберите значение</option>
                                        @if (ViewBag.Users != null)
                                        {
                                            foreach (var u in (List<string>)ViewBag.Users)
                                            {
                                                if (Model.Employee == u)
                                                {
                                                    <option value="@u" selected>@u</option>
                                                }
                                                else
                                                {
                                                    <option value="@u">@u</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Department">Отдел <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input asp-for="Department" class="form-control" id="Department"
                                               placeholder="Введите или выберите отдел" autocomplete="off" readonly="@(!isAdmin)">
                                        @if (isAdmin)
                                        {
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-secondary"
                                                        onclick="openModal('modalDepartments')"
                                                        title="Выбрать из существующих">
                                                    <i class="fas fa-list"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="WarrantyPeriod">Срок гарантии</label>
                                    <select asp-for="WarrantyPeriod" class="form-control" disabled="@(!isAdmin)"
                                            asp-items='@(new SelectList(new[] { "3 мес","6 мес","12 мес","24 мес","36 мес","60 мес" }))'>
                                        <option value="">Выберите опцию</option>
                                    </select>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="PlannedEndDate">Плановая дата завершения</label>
                                    <div class="input-group date">
                                        @{ var plannedVal = Model.PlannedEndDate.HasValue ? Model.PlannedEndDate.Value.ToString("yyyy-MM-dd") : ""; }
                                        <input asp-for="PlannedEndDate" id="PlannedEndDate" type="date" class="form-control" value="@plannedVal" readonly="@(!isAdmin)">
                                    </div>
                                </div>

                                <div class="col-12 form-group">
                                    <div class="icheck-primary">
                                        @if (Model.IsActive)
                                        {
                                            <input asp-for="IsActive" type="checkbox" id="chkActive" checked disabled="@(!isAdmin)">
                                        }
                                        else
                                        {
                                            <input asp-for="IsActive" type="checkbox" id="chkActive" disabled="@(!isAdmin)">
                                        }
                                        <label for="chkActive">Актуальный</label>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div id="newContractInputs"></div>

                        <div class="card-footer d-flex gap-2">
                            @if (isAdmin)
                            {
                                <button type="submit" class="btn btn-success">
                                    Сохранить
                                </button>
                            }
                            <a asp-action="Index" class="btn btn-default">
                                @(isAdmin ? "Отменить" : "Назад")
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="tab-pane fade" id="tabContracts">
                <div class="card card-outline card-info" style="border-top-left-radius:0">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-file-contract me-1"></i>Прикреплённые договоры
                        </h3>
                    </div>
                    <div class="card-body">

                        <div class="mb-4">
                            <label class="font-weight-bold mb-2 d-block">
                                <i class="fas fa-search me-1 text-muted"></i>Найти и прикрепить договор
                            </label>
                            @if (isAdmin)
                            {
                                <div class="input-group">
                                    <input type="text" id="contractSearchInput" class="form-control contract-search-input"
                                           placeholder="Поиск по номеру или наименованию договора..."
                                           autocomplete="off">
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-secondary" id="btnClearContractSearch"
                                                title="Очистить">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="contract-results" id="contractResults"></div>
                            }
                            else
                            {
                                <div class="alert alert-secondary py-2" style="font-size:13px;border-radius:8px">
                                    <i class="fas fa-lock me-1"></i>Прикрепление договоров доступно только администратору
                                </div>
                            }
                        </div>

                        @if (isEdit)
                        {
                            @if (!Model.ProjectContracts.Any())
                            {
                                <div class="text-center text-muted py-4" id="emptyContracts">
                                    <i class="fas fa-file-contract fa-3x d-block mb-2"></i>
                                    Нет прикреплённых договоров
                                </div>
                            }
                            else
                            {
                                <table class="table table-hover table-sm" id="contractsTable">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Номер договора</th>
                                            <th>Наименование</th>
                                            <th>Дата заключения</th>
                                            @if (isAdmin) { <th style="width:80px" class="text-right">Открепить</th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var pc in Model.ProjectContracts.OrderByDescending(x => x.AttachedAt))
                                        {
                                            <tr>
                                                <td>
                                                    <a href="/Contracts/Edit/@pc.Contract?.Id" target="_blank" class="text-info" title="Открыть договор">
                                                        <i class="fas fa-file-contract me-1"></i>
                                                        <strong>@(pc.Contract?.ContractNumber ?? "—")</strong>
                                                    </a>
                                                </td>
                                                <td class="text-muted small">
                                                    @(pc.Contract?.FullName ?? "—")
                                                </td>
                                                <td class="text-muted small">
                                                    @(pc.Contract?.ConclusionDate.HasValue == true
                                                        ? pc.Contract.ConclusionDate.Value.ToString("dd.MM.yyyy") : "—")
                                                </td>
                                                @if (isAdmin)
                                                {
                                                    <td class="text-right">
                                                        <form asp-action="DetachContract" method="post" class="d-inline"
                                                              onsubmit="return confirm('Открепить договор «@(pc.Contract?.ContractNumber)» от проекта?')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="projectContractId" value="@pc.Id" />
                                                            <input type="hidden" name="projectId"         value="@Model.Id" />
                                                            <button type="submit" class="btn btn-xs btn-danger" title="Открепить">
                                                                <i class="fas fa-unlink"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                        else
                        {
                            <div id="emptyContracts" class="text-center text-muted py-4">
                                <i class="fas fa-file-contract fa-3x d-block mb-2"></i>
                                Договоры не выбраны
                            </div>
                            <table class="table table-hover table-sm d-none" id="contractsTable">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Номер договора</th>
                                        <th>Наименование</th>
                                        <th>Дата заключения</th>
                                        <th style="width:60px" class="text-right">Убрать</th>
                                    </tr>
                                </thead>
                                <tbody id="newContractsTbody"></tbody>
                            </table>
                            
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


<div class="modal fade" id="modalProjectGroups" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:12px;overflow:hidden">
            <div class="modal-header border-0" style="background:linear-gradient(135deg,#5c6bc0,#3f51b5);padding:16px 20px">
                <h5 class="modal-title text-white fw-semibold" style="font-size:15px">
                    <i class="fas fa-layer-group me-2"></i>Группа проектов
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body p-0">
                <div class="p-3" style="border-bottom:1px solid #f0f0f0">
                    <input type="text" id="pgNewValue" class="form-control form-control-sm"
                           placeholder="Введите новую группу..." style="border-radius:8px">
                </div>
                <div style="max-height:260px;overflow-y:auto">
                    @if (ViewBag.ProjectGroups != null && ((List<string>)ViewBag.ProjectGroups).Any())
                    {
                        foreach (var g in (List<string>)ViewBag.ProjectGroups)
                        {
                            <div class="modal-pick-item" data-field="ProjectGroup" data-value="@g"
                                 style="padding:10px 20px;cursor:pointer;border-bottom:1px solid #f8f8f8;font-size:14px;display:flex;align-items:center;gap:10px;transition:background .15s">
                                <i class="fas fa-layer-group" style="color:#9c9fc9;font-size:12px;width:14px"></i>
                                <span>@g</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4" style="color:#bbb;font-size:13px">
                            <i class="fas fa-inbox d-block mb-2" style="font-size:24px"></i>
                            Нет сохранённых групп
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0" style="padding:12px 16px;background:#fafafa">
                <button type="button" class="btn btn-sm btn-success w-100" id="btnAddPg" style="border-radius:8px">
                    <i class="fas fa-plus me-1"></i>Добавить новую
                </button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalDepartments" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:12px;overflow:hidden">
            <div class="modal-header border-0" style="background:linear-gradient(135deg,#5c6bc0,#3f51b5);padding:16px 20px">
                <h5 class="modal-title text-white fw-semibold" style="font-size:15px">
                    <i class="fas fa-sitemap me-2"></i>Отдел
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body p-0">
                <div class="p-3" style="border-bottom:1px solid #f0f0f0">
                    <input type="text" id="deptNewValue" class="form-control form-control-sm"
                           placeholder="Введите новый отдел..." style="border-radius:8px">
                </div>
                <div style="max-height:260px;overflow-y:auto">
                    @if (ViewBag.Departments != null && ((List<string>)ViewBag.Departments).Any())
                    {
                        foreach (var d in (List<string>)ViewBag.Departments)
                        {
                            <div class="modal-pick-item" data-field="Department" data-value="@d"
                                 style="padding:10px 20px;cursor:pointer;border-bottom:1px solid #f8f8f8;font-size:14px;display:flex;align-items:center;gap:10px;transition:background .15s">
                                <i class="fas fa-sitemap" style="color:#9c9fc9;font-size:12px;width:14px"></i>
                                <span>@d</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4" style="color:#bbb;font-size:13px">
                            <i class="fas fa-inbox d-block mb-2" style="font-size:24px"></i>
                            Нет сохранённых отделов
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0" style="padding:12px 16px;background:#fafafa">
                <button type="button" class="btn btn-sm btn-success w-100" id="btnAddDept" style="border-radius:8px">
                    <i class="fas fa-plus me-1"></i>Добавить новый
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    function escHtml(str) {
        return String(str)
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function pickCp(display) {
        $('#ContractorsHidden').val(display);
        $('#cpDisplay').text(display);
        $('#cpWrap').removeClass('cs-open');
        $('#cpList .cs-option').removeClass('cs-selected');
        $('#cpList .cs-option').filter(function() {
            return $(this).text().trim() === display;
        }).addClass('cs-selected');
    }

    function openModal(id) {
        var el = document.getElementById(id);
        if (el) bootstrap.Modal.getOrCreateInstance(el).show();
    }
    function hideAllModals() {
        ['modalProjectGroups','modalDepartments'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) {
                var m = bootstrap.Modal.getInstance(el);
                if (m) m.hide();
            }
        });
    }

    $(function () {

        
        if (window.location.hash === '#contracts') {
            var tabEl = document.getElementById('contractsTabLink');
            if (tabEl) bootstrap.Tab.getOrCreateInstance(tabEl).show();
        }

        $(document).on('mouseenter', '.modal-pick-item', function() {
            $(this).css('background','#f0f2ff');
        }).on('mouseleave', '.modal-pick-item', function() {
            $(this).css('background','');
        });

        $(document).on('click', '.modal-pick-item', function() {
            var field = $(this).data('field');
            var value = $(this).data('value');
            document.getElementById(field).value = value;
            hideAllModals();
        });

        $('#btnAddPg').on('click', function() {
            var val = $('#pgNewValue').val().trim();
            if (!val) { $('#pgNewValue').focus(); return; }
            document.getElementById('ProjectGroup').value = val;
            $('#pgNewValue').val('');
            hideAllModals();
        });

        $('#btnAddDept').on('click', function() {
            var val = $('#deptNewValue').val().trim();
            if (!val) { $('#deptNewValue').focus(); return; }
            document.getElementById('Department').value = val;
            $('#deptNewValue').val('');
            hideAllModals();
        });

        $('#pgNewValue').on('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); $('#btnAddPg').click(); }
        });
        $('#deptNewValue').on('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); $('#btnAddDept').click(); }
        });

        $('#StartDate, #PlannedEndDate, #ActualEndDate').on('change', validateDates);

        
        var cpLoaded = false;
        var cpTimer;

        $('#cpTrigger').on('click', function (e) {
            e.stopPropagation();
            var wrap = $('#cpWrap');
            if (wrap.hasClass('cs-open')) {
                wrap.removeClass('cs-open');
            } else {
                wrap.addClass('cs-open');
                if (!cpLoaded) { loadCp(''); cpLoaded = true; }
                setTimeout(function() { $('#cpSearch').focus(); }, 50);
            }
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#cpWrap').length)
                $('#cpWrap').removeClass('cs-open');
        });

        $('#cpSearch').on('input', function () {
            clearTimeout(cpTimer);
            cpTimer = setTimeout(function () {
                loadCp($('#cpSearch').val());
            }, 300);
        }).on('click', function(e) { e.stopPropagation(); });

        $(document).on('click', '#cpList .cs-option[data-cp]', function() {
            pickCp($(this).data('cp'));
        });

        function loadCp(q) {
            $('#cpList').html('<div class="cs-option cs-loading"><i class="fas fa-spinner fa-spin me-1"></i> Загрузка...</div>');
            var url = '@Url.Action("SearchCounterparties","Projects")' + '?q=' + encodeURIComponent(q || '');
            fetch(url)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (!data || !data.length) {
                        $('#cpList').html('<div class="cs-option cs-no-results">Контрагенты не найдены</div>');
                        return;
                    }
                    var html = '';
                    var cur = $('#ContractorsHidden').val();
                    data.forEach(function(item) {
                        var sel = (item.display === cur) ? ' cs-selected' : '';
                        html += '<div class="cs-option' + sel + '" data-cp="' + escHtml(item.display) + '">' +
                                '<i class="fas fa-building text-muted me-2"></i>' + escHtml(item.display) + '</div>';
                    });
                    $('#cpList').html(html);
                })
                .catch(function() {
                    $('#cpList').html('<div class="cs-option cs-no-results text-danger">Ошибка загрузки</div>');
                });
        }

    
        var contractTimer;
        var projectId = @(isEdit ? Model.Id.ToString() : "0");

        $('#contractSearchInput').on('input', function () {
            var q = $(this).val().trim();
            clearTimeout(contractTimer);
            if (q.length < 1) {
                $('#contractResults').removeClass('open').html('');
                return;
            }
            contractTimer = setTimeout(function() { searchContracts(q); }, 300);
        }).on('focus', function() {
            var q = $(this).val().trim();
            if (q.length >= 1) searchContracts(q);
        });

        $('#btnClearContractSearch').on('click', function() {
            $('#contractSearchInput').val('');
            $('#contractResults').removeClass('open').html('');
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('#contractSearchInput, #contractResults, #btnClearContractSearch').length)
                $('#contractResults').removeClass('open');
        });

        function searchContracts(q) {
            var url = '@Url.Action("SearchContracts","Projects")'
                      + '?q=' + encodeURIComponent(q)
                      + '&projectId=' + projectId;

            $('#contractResults').addClass('open')
                .html('<div class="contract-result-item text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Поиск...</div>');

            fetch(url)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (!data || !data.length) {
                        $('#contractResults').html(
                            '<div class="contract-result-item text-muted text-center py-2">Договоры не найдены</div>');
                        return;
                    }
                    var html = '';
                    data.forEach(function(c) {
                        html += '<div class="contract-result-item"' +
                                ' data-id="' + c.id + '"' +
                                ' data-num="' + escHtml(c.contractNumber || '') + '"' +
                                ' data-name="' + escHtml(c.subject || '') + '"' +
                                ' data-date="' + escHtml(c.signDate || '') + '">' +
                                '<div class="cn"><i class="fas fa-file-contract text-info me-1"></i>' + escHtml(c.contractNumber || '—') + '</div>' +
                                '<div class="cs">' + escHtml(c.subject || '—') +
                                (c.signDate ? ' &nbsp;·&nbsp; ' + escHtml(c.signDate) : '') + '</div>' +
                                '</div>';
                    });
                    $('#contractResults').html(html);
                })
                .catch(function() {
                    $('#contractResults').html(
                        '<div class="contract-result-item text-danger">Ошибка поиска</div>');
                });
        }

        
        $(document).on('click', '.contract-result-item[data-id]', function() {
            var contractId   = $(this).data('id');
            var contractNum  = $(this).data('num');
            var contractName = $(this).data('name');
            var contractDate = $(this).data('date');

            if (@(isEdit ? "true" : "false")) {
                var form = $('<form method="post" style="display:none">' +
                    '<input name="projectId"  value="' + projectId + '">' +
                    '<input name="contractId" value="' + contractId + '">' +
                    '@Html.AntiForgeryToken()' +
                    '</form>');
                form.attr('action', '@Url.Action("AttachContract","Projects")');
                $('body').append(form);
                form.submit();
            } else {
                if ($('#newContractInputs input[value="' + contractId + '"]').length) return;

                $('#newContractInputs').append(
                    '<input type="hidden" name="newContractIds" value="' + contractId + '">'
                );

                var row = '<tr data-cid="' + contractId + '">' +
                    '<td><i class="fas fa-file-contract text-info me-1"></i><strong>' + escHtml(contractNum || '—') + '</strong></td>' +
                    '<td class="text-muted small">' + escHtml(contractName || '—') + '</td>' +
                    '<td class="text-muted small">' + escHtml(contractDate || '—') + '</td>' +
                    '<td class="text-right"><button type="button" class="btn btn-xs btn-danger btn-remove-contract" title="Убрать"><i class="fas fa-times"></i></button></td>' +
                    '</tr>';
                $('#newContractsTbody').append(row);

                $('#emptyContracts').addClass('d-none');
                $('#contractsTable').removeClass('d-none');
                $('#contractCount').text(parseInt($('#contractCount').text()) + 1);
                $('#contractSearchInput').val('');
                $('#contractResults').removeClass('open').html('');
            }
        });

        $(document).on('click', '.btn-remove-contract', function() {
            var row = $(this).closest('tr');
            var cid = row.data('cid');
            row.remove();
            $('#newContractInputs input[value="' + cid + '"]').remove();
            var cnt = parseInt($('#contractCount').text()) - 1;
            $('#contractCount').text(Math.max(0, cnt));
            if ($('#newContractsTbody tr').length === 0) {
                $('#contractsTable').addClass('d-none');
                $('#emptyContracts').removeClass('d-none');
            }
        });

        $('#projectForm').on('submit', function (e) {
            validateDates();
            if ($('.date-error').length > 0) {
                e.preventDefault();
                $('html, body').animate({ scrollTop: $('.date-error').first().offset().top - 100 }, 400);
            }
        });
    });

    function validateDates() {
        var start   = $('#StartDate').val();
        var planned = $('#PlannedEndDate').val();
        var actual  = $('#ActualEndDate').val();

        clearDateError('PlannedEndDate');
        clearDateError('ActualEndDate');

        if (!start) return;
        if (planned && planned < start)
            showDateError('PlannedEndDate', 'Плановая дата не может быть раньше даты начала');
        if (actual && actual < start)
            showDateError('ActualEndDate', 'Фактическая дата не может быть раньше даты начала');
    }

    function showDateError(fieldId, msg) {
        var field = $('#' + fieldId);
        field.addClass('is-invalid');
        if (!field.closest('.input-group').next('.date-error').length)
            field.closest('.input-group').after('<span class="text-danger small date-error">' + msg + '</span>');
    }

    function clearDateError(fieldId) {
        $('#' + fieldId).removeClass('is-invalid')
            .closest('.input-group').next('.date-error').remove();
    }
    </script>
}
