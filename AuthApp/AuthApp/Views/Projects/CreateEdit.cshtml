@model AuthApp.Models.Project
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Редактирование проекта" : "Создание проекта";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var extIcons = new Dictionary<string, string>
    {
        [".pdf"]  = "fa-file-pdf text-danger",
        [".doc"]  = "fa-file-word text-primary",
        [".docx"] = "fa-file-word text-primary",
        [".xls"]  = "fa-file-excel text-success",
        [".xlsx"] = "fa-file-excel text-success",
        [".zip"]  = "fa-file-archive text-warning",
        [".rar"]  = "fa-file-archive text-warning",
        [".7z"]   = "fa-file-archive text-warning",
    };
    string DocIcon(string? ext) =>
        ext != null && extIcons.TryGetValue(ext, out var ic) ? ic : "fa-file text-muted";
}

<style>
    
    .cs-wrap { position: relative; width: 100%; }

    .cs-trigger {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        width: 100%; min-height: 38px; padding: 6px 12px;
        border: 1px solid #d2d6de; border-radius: 4px;
        background: #fff; cursor: pointer; font-size: 14px; color: #333;
        transition: border-color .15s, box-shadow .15s; user-select: none;
    }
    .cs-trigger:hover { border-color: #aaa; }
    .cs-wrap.cs-open .cs-trigger { border-color: #3c8dbc; box-shadow: 0 0 0 2px rgba(60,141,188,.2); }
    .cs-trigger-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cs-arrow { flex-shrink: 0; color: #999; transition: transform .2s; }
    .cs-wrap.cs-open .cs-arrow { transform: rotate(180deg); }

    .cs-dropdown {
        display: none; position: absolute; top: calc(100% + 2px); left: 0; right: 0;
        z-index: 9999; background: #fff; border: 1px solid #d2d6de;
        border-radius: 4px; box-shadow: 0 4px 16px rgba(0,0,0,.15); overflow: hidden;
    }
    .cs-wrap.cs-open .cs-dropdown { display: block; }

    .cs-search-wrap { padding: 8px; border-bottom: 1px solid #eee; }
    .cs-search {
        width: 100%; padding: 6px 10px; border: 1px solid #d2d6de;
        border-radius: 3px; font-size: 13px; outline: none;
    }
    .cs-search:focus { border-color: #3c8dbc; }

    .cs-list { max-height: 220px; overflow-y: auto; }
    .cs-option { padding: 8px 12px; font-size: 13px; color: #333; cursor: pointer; transition: background .1s; }
    .cs-option:hover { background: #f4f6f9; }
    .cs-option.cs-selected { background: #e8f4fd; font-weight: 600; }
    .cs-option.cs-placeholder { color: #aaa; }
    .cs-option.cs-no-results { color: #aaa; text-align: center; padding: 16px; cursor: default; }
    .cs-option.cs-loading { color: #aaa; text-align: center; padding: 12px; cursor: default; }
</style>

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Главная</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Проекты</a></li>
                    <li class="breadcrumb-item active">@(isEdit ? "Редактирование" : "Создание")</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <ul class="nav nav-tabs mb-0" id="projectTabs">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabInfo" href="#">
                    <i class="fas fa-info-circle me-1"></i>Общая информация
                </a>
            </li>
            @if (isEdit)
            {
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" data-bs-target="#tabDocs" href="#" id="docsTabLink">
                        <i class="fas fa-paperclip me-1"></i>Документы
                        <span class="badge bg-secondary ms-1" id="docCount">@Model.ProjectDocuments.Count</span>
                    </a>
                </li>
            }
        </ul>

        <div class="tab-content">

            <div class="tab-pane fade show active" id="tabInfo">
                <div class="card card-outline card-primary" style="border-top-left-radius:0">
                    <div class="card-header">
                        <h3 class="card-title">Общая информация</h3>
                    </div>

                    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post"
                          enctype="multipart/form-data" id="projectForm">
                        @Html.AntiForgeryToken()
                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="CreatedAt" />
                        }

                        <div class="card-body">
                            <div class="row">

                                <div class="col-md-6 form-group">
                                    <label asp-for="Name">Наименование проекта <span class="text-danger">*</span></label>
                                    <input asp-for="Name" class="form-control" placeholder="Введите наименование">
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Team">Команда проекта <span class="text-danger">*</span></label>
                                    <input asp-for="Team" class="form-control" placeholder="Введите команду">
                                    <span asp-validation-for="Team" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Budget">Сумма (бюджет)</label>
                                    <input asp-for="Budget" type="number" step="0.01" min="0"
                                           class="form-control" placeholder="Введите сумму">
                                    <span asp-validation-for="Budget" class="text-danger small"></span>
                                </div>

                                <div class="col-12 form-group">
                                    <label asp-for="Description">Описание <span class="text-danger">*</span></label>
                                    <textarea asp-for="Description" class="form-control" rows="3"
                                              placeholder="Введите описание проекта"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Status">Статус <span class="text-danger">*</span></label>
                                    <select asp-for="Status" class="form-control"
                                            asp-items='@(new SelectList(new[] {
                                                "На стадии идеи","Разработка бюджета и КП","Бюджет утвержден",
                                                "Объявлены закупки","Договор на согласовании","На регистрации","Выполняется","Завершен"
                                            }))'>
                                        <option value="">Выберите опцию</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="ProjectGroup">Группа проектов</label>
                                    <div class="input-group">
                                        <input asp-for="ProjectGroup" class="form-control" id="ProjectGroup"
                                               placeholder="Введите или выберите группу" autocomplete="off">
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-secondary"
                                                    onclick="openModal('modalProjectGroups')"
                                                    title="Выбрать из существующих">
                                                <i class="fas fa-list"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="ResponsiblePerson">Ответственный <span class="text-danger">*</span></label>
                                    <select asp-for="ResponsiblePerson" class="form-control">
                                        <option value="">Выберите значение</option>
                                        @if (ViewBag.Users != null)
                                        {
                                            foreach (var u in (List<string>)ViewBag.Users)
                                            {
                                                if (Model.ResponsiblePerson == u)
                                                {
                                                    <option value="@u" selected>@u</option>
                                                }
                                                else
                                                {
                                                    <option value="@u">@u</option>
                                                }
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="ResponsiblePerson" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="StartDate">Дата начала <span class="text-danger">*</span></label>
                                    <div class="input-group date">
                                        @{ var startVal = Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : ""; }
                                        <input asp-for="StartDate" type="date" class="form-control" value="@startVal">
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="ActualEndDate">Фактическая дата завершения</label>
                                    <div class="input-group date">
                                        @{ var actualVal = Model.ActualEndDate.HasValue ? Model.ActualEndDate.Value.ToString("yyyy-MM-dd") : ""; }
                                        <input asp-for="ActualEndDate" type="date" class="form-control" value="@actualVal">
                                    </div>
                                </div>

                                
                                <div class="col-md-6 form-group">
                                    <label asp-for="Contractors">Контрагенты <span class="text-danger">*</span></label>

                                    
                                    <input type="hidden" asp-for="Contractors" id="ContractorsHidden" />

                                    <div class="cs-wrap" id="cpWrap">
                                        <div class="cs-trigger" id="cpTrigger">
                                            <span class="cs-trigger-text" id="cpDisplay">
                                                @(string.IsNullOrEmpty(Model.Contractors)
                                                    ? "— Выберите контрагента —"
                                                    : Model.Contractors)
                                            </span>
                                            <i class="fas fa-chevron-down cs-arrow"></i>
                                        </div>
                                        <div class="cs-dropdown" id="cpDropdown">
                                            <div class="cs-search-wrap">
                                                <input type="text" class="cs-search" id="cpSearch"
                                                       placeholder="Поиск по названию...">
                                            </div>
                                            <div class="cs-list" id="cpList">
                                                <div class="cs-option cs-loading">
                                                    <i class="fas fa-spinner fa-spin me-1"></i> Загрузка...
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Contractors" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="InterestSource">Источник интереса <span class="text-danger">*</span></label>
                                    <select asp-for="InterestSource" class="form-control"
                                            asp-items='@(new SelectList(new[] {
                                                "Постоянный клиент","Самопроизвольный","Сотрудник","Партнер"
                                            }))'>
                                        <option value="">Выберите опцию</option>
                                    </select>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Employee">Сотрудник</label>
                                    <select asp-for="Employee" class="form-control">
                                        <option value="">Выберите значение</option>
                                        @if (ViewBag.Users != null)
                                        {
                                            foreach (var u in (List<string>)ViewBag.Users)
                                            {
                                                if (Model.Employee == u)
                                                {
                                                    <option value="@u" selected>@u</option>
                                                }
                                                else
                                                {
                                                    <option value="@u">@u</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="Department">Отдел <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input asp-for="Department" class="form-control" id="Department"
                                               placeholder="Введите или выберите отдел" autocomplete="off">
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-secondary"
                                                    onclick="openModal('modalDepartments')"
                                                    title="Выбрать из существующих">
                                                <i class="fas fa-list"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="WarrantyPeriod">Срок гарантии</label>
                                    <select asp-for="WarrantyPeriod" class="form-control"
                                            asp-items='@(new SelectList(new[] { "3 мес","6 мес","12 мес","24 мес","36 мес","60 мес" }))'>
                                        <option value="">Выберите опцию</option>
                                    </select>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="PlannedEndDate">Плановая дата завершения</label>
                                    <div class="input-group date">
                                        @{ var plannedVal = Model.PlannedEndDate.HasValue ? Model.PlannedEndDate.Value.ToString("yyyy-MM-dd") : ""; }
                                        <input asp-for="PlannedEndDate" type="date" class="form-control" value="@plannedVal">
                                    </div>
                                </div>

                                <div class="col-12 form-group">
                                    <div class="icheck-primary">
                                        @if (Model.IsActive)
                                        {
                                            <input asp-for="IsActive" type="checkbox" id="chkActive" checked>
                                        }
                                        else
                                        {
                                            <input asp-for="IsActive" type="checkbox" id="chkActive">
                                        }
                                        <label for="chkActive">Актуальный</label>
                                    </div>
                                </div>

                                @if (!isEdit)
                                {
                                    <div class="col-12 form-group">
                                        <label>Документы</label>
                                        <div class="custom-file">
                                            <input type="file" name="documents" multiple class="custom-file-input"
                                                   id="docsInput" accept=".doc,.docx,.xls,.xlsx,.pdf,.zip,.rar,.7z">
                                            <label class="custom-file-label" for="docsInput">Выберите файлы...</label>
                                        </div>
                                        <small class="text-muted">Допустимые форматы: doc, docx, xls, xlsx, pdf, zip, rar, 7z</small>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="card-footer d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                Сохранить
                            </button>
                            <a asp-action="Index" class="btn btn-default">
                                Отменить
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            @if (isEdit)
            {
                <div class="tab-pane fade" id="tabDocs">
                    <div class="card card-outline card-info" style="border-top-left-radius:0">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-paperclip me-1"></i>Документы проекта</h3>
                        </div>
                        <div class="card-body">

                            <form asp-action="Edit" asp-route-id="@Model.Id" method="post"
                                  enctype="multipart/form-data" class="mb-4">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id"               value="@Model.Id" />
                                <input type="hidden" name="Name"             value="@Model.Name" />
                                <input type="hidden" name="Team"             value="@Model.Team" />
                                <input type="hidden" name="Description"      value="@Model.Description" />
                                <input type="hidden" name="Status"           value="@Model.Status" />
                                <input type="hidden" name="ResponsiblePerson" value="@Model.ResponsiblePerson" />
                                <input type="hidden" name="StartDate"        value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="ActualEndDate"    value="@Model.ActualEndDate?.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="PlannedEndDate"   value="@Model.PlannedEndDate?.ToString("yyyy-MM-dd")" />
                                <input type="hidden" name="Contractors"      value="@Model.Contractors" />
                                <input type="hidden" name="InterestSource"   value="@Model.InterestSource" />
                                <input type="hidden" name="Employee"         value="@Model.Employee" />
                                <input type="hidden" name="Department"       value="@Model.Department" />
                                <input type="hidden" name="WarrantyPeriod"   value="@Model.WarrantyPeriod" />
                                <input type="hidden" name="ProjectGroup"     value="@Model.ProjectGroup" />
                                <input type="hidden" name="IsActive"         value="@Model.IsActive.ToString().ToLower()" />
                                <input type="hidden" name="CreatedAt"        value="@Model.CreatedAt.ToString("o")" />

                                <div class="input-group">
                                    <div class="custom-file">
                                        <input type="file" name="documents" multiple
                                               class="custom-file-input" id="docsUpload"
                                               accept=".doc,.docx,.xls,.xlsx,.pdf,.zip,.rar,.7z">
                                        <label class="custom-file-label" for="docsUpload">Выберите файлы...</label>
                                    </div>
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-upload me-1"></i>Загрузить
                                        </button>
                                    </div>
                                </div>
                                <small class="text-muted">Форматы: doc, docx, xls, xlsx, pdf, zip, rar, 7z</small>
                            </form>

                            @if (!Model.ProjectDocuments.Any())
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-folder-open fa-3x d-block mb-2"></i>
                                    Нет прикреплённых документов
                                </div>
                            }
                            else
                            {
                                <table class="table table-hover table-sm">
                                    <thead class="thead-light">
                                        <tr>
                                            <th style="width:36px"></th>
                                            <th>Имя файла</th>
                                            <th>Дата загрузки</th>
                                            <th style="width:100px" class="text-right">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in Model.ProjectDocuments.OrderByDescending(d => d.UploadDate))
                                        {
                                            <tr>
                                                <td class="text-center">
                                                    <i class="fas @DocIcon(doc.Extension) fa-lg"></i>
                                                </td>
                                                <td>
                                                    <a asp-action="DownloadDocument" asp-route-docId="@doc.Id"
                                                       class="text-dark font-weight-medium">
                                                        @doc.FileName
                                                    </a>
                                                </td>
                                                <td class="text-muted small">
                                                    @doc.UploadDate.ToString("dd.MM.yyyy HH:mm")
                                                </td>
                                                <td class="text-right">
                                                    <a asp-action="DownloadDocument" asp-route-docId="@doc.Id"
                                                       class="btn btn-xs btn-default" title="Скачать">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                    <form asp-action="DeleteDocument" method="post" class="d-inline"
                                                          onsubmit="return confirm('Удалить файл «@doc.FileName»?')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="docId"     value="@doc.Id" />
                                                        <input type="hidden" name="projectId" value="@Model.Id" />
                                                        <button type="submit" class="btn btn-xs btn-danger" title="Удалить">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }

                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</section>


<div class="modal fade" id="modalProjectGroups" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:12px;overflow:hidden">
            <div class="modal-header border-0" style="background:linear-gradient(135deg,#5c6bc0,#3f51b5);padding:16px 20px">
                <h5 class="modal-title text-white fw-semibold" style="font-size:15px">
                    <i class="fas fa-layer-group me-2"></i>Группа проектов
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body p-0">
                <div class="p-3" style="border-bottom:1px solid #f0f0f0">
                    <input type="text" id="pgNewValue" class="form-control form-control-sm"
                           placeholder="Введите новую группу..." style="border-radius:8px">
                </div>
                <div style="max-height:260px;overflow-y:auto">
                    @if (ViewBag.ProjectGroups != null && ((List<string>)ViewBag.ProjectGroups).Any())
                    {
                        foreach (var g in (List<string>)ViewBag.ProjectGroups)
                        {
                            <div class="modal-pick-item" data-field="ProjectGroup" data-value="@g"
                                 style="padding:10px 20px;cursor:pointer;border-bottom:1px solid #f8f8f8;font-size:14px;display:flex;align-items:center;gap:10px;transition:background .15s">
                                <i class="fas fa-layer-group" style="color:#9c9fc9;font-size:12px;width:14px"></i>
                                <span>@g</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4" style="color:#bbb;font-size:13px">
                            <i class="fas fa-inbox d-block mb-2" style="font-size:24px"></i>
                            Нет сохранённых групп
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0" style="padding:12px 16px;background:#fafafa">
                <button type="button" class="btn btn-sm btn-success w-100" id="btnAddPg" style="border-radius:8px">
                    <i class="fas fa-plus me-1"></i>Добавить новую
                </button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalDepartments" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:12px;overflow:hidden">
            <div class="modal-header border-0" style="background:linear-gradient(135deg,#5c6bc0,#3f51b5);padding:16px 20px">
                <h5 class="modal-title text-white fw-semibold" style="font-size:15px">
                    <i class="fas fa-sitemap me-2"></i>Отдел
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body p-0">
                <div class="p-3" style="border-bottom:1px solid #f0f0f0">
                    <input type="text" id="deptNewValue" class="form-control form-control-sm"
                           placeholder="Введите новый отдел..." style="border-radius:8px">
                </div>
                <div style="max-height:260px;overflow-y:auto">
                    @if (ViewBag.Departments != null && ((List<string>)ViewBag.Departments).Any())
                    {
                        foreach (var d in (List<string>)ViewBag.Departments)
                        {
                            <div class="modal-pick-item" data-field="Department" data-value="@d"
                                 style="padding:10px 20px;cursor:pointer;border-bottom:1px solid #f8f8f8;font-size:14px;display:flex;align-items:center;gap:10px;transition:background .15s">
                                <i class="fas fa-sitemap" style="color:#9c9fc9;font-size:12px;width:14px"></i>
                                <span>@d</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4" style="color:#bbb;font-size:13px">
                            <i class="fas fa-inbox d-block mb-2" style="font-size:24px"></i>
                            Нет сохранённых отделов
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0" style="padding:12px 16px;background:#fafafa">
                <button type="button" class="btn btn-sm btn-success w-100" id="btnAddDept" style="border-radius:8px">
                    <i class="fas fa-plus me-1"></i>Добавить новый
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
   
    function escHtml(str) {
        return String(str)
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }


    function pickCp(display) {
        $('#ContractorsHidden').val(display);
        $('#cpDisplay').text(display);
        $('#cpWrap').removeClass('cs-open');
        $('#cpList .cs-option').removeClass('cs-selected');
        $('#cpList .cs-option').filter(function() {
            return $(this).text().trim() === display;
        }).addClass('cs-selected');
    }

    
    function openModal(id) {
        var el = document.getElementById(id);
        if (el) bootstrap.Modal.getOrCreateInstance(el).show();
    }
    function hideAllModals() {
        ['modalProjectGroups','modalDepartments'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) {
                var m = bootstrap.Modal.getInstance(el);
                if (m) m.hide();
            }
        });
    }

    $(function () {
     
        $('input[type=file]').on('change', function () {
            var names = Array.from(this.files).map(function(f){ return f.name; }).join(', ');
            $(this).next('.custom-file-label').text(names || 'Выберите файлы...');
        });

       
        if (window.location.hash === '#docs') {
            var tabEl = document.getElementById('docsTabLink');
            if (tabEl) bootstrap.Tab.getOrCreateInstance(tabEl).show();
        }

        $(document).on('mouseenter', '.modal-pick-item', function() {
            $(this).css('background','#f0f2ff');
        }).on('mouseleave', '.modal-pick-item', function() {
            $(this).css('background','');
        });

        $(document).on('click', '.modal-pick-item', function() {
            var field = $(this).data('field');
            var value = $(this).data('value');
            document.getElementById(field).value = value;
            hideAllModals();
        });

        $('#btnAddPg').on('click', function() {
            var val = $('#pgNewValue').val().trim();
            if (!val) { $('#pgNewValue').focus(); return; }
            document.getElementById('ProjectGroup').value = val;
            $('#pgNewValue').val('');
            hideAllModals();
        });

        $('#btnAddDept').on('click', function() {
            var val = $('#deptNewValue').val().trim();
            if (!val) { $('#deptNewValue').focus(); return; }
            document.getElementById('Department').value = val;
            $('#deptNewValue').val('');
            hideAllModals();
        });

        
        $('#pgNewValue').on('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); $('#btnAddPg').click(); }
        });
        $('#deptNewValue').on('keydown', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); $('#btnAddDept').click(); }
        });

        $('#StartDate, #PlannedEndDate, #ActualEndDate').on('change', validateDates);

      
        var cpLoaded = false;
        var cpTimer;

        $('#cpTrigger').on('click', function (e) {
            e.stopPropagation();
            var wrap = $('#cpWrap');
            if (wrap.hasClass('cs-open')) {
                wrap.removeClass('cs-open');
            } else {
                wrap.addClass('cs-open');
                if (!cpLoaded) { loadCp(''); cpLoaded = true; }
                setTimeout(function() { $('#cpSearch').focus(); }, 50);
            }
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#cpWrap').length)
                $('#cpWrap').removeClass('cs-open');
        });

        $('#cpSearch').on('input', function () {
            clearTimeout(cpTimer);
            cpTimer = setTimeout(function () {
                loadCp($('#cpSearch').val());
            }, 300);
        }).on('click', function(e) { e.stopPropagation(); });

       
        $(document).on('click', '#cpList .cs-option[data-cp]', function() {
            pickCp($(this).data('cp'));
        });

        function loadCp(q) {
            $('#cpList').html('<div class="cs-option cs-loading"><i class="fas fa-spinner fa-spin me-1"></i> Загрузка...</div>');

            var url = '@Url.Action("SearchCounterparties","Projects")' + '?q=' + encodeURIComponent(q || '');

            var controller = new AbortController();
            var timeout = setTimeout(function() { controller.abort(); }, 8000);

            fetch(url, { signal: controller.signal })
                .then(function(r) {
                    clearTimeout(timeout);
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(function(data) {
                    if (!data || !data.length) {
                        $('#cpList').html('<div class="cs-option cs-no-results">Контрагенты не найдены</div>');
                        return;
                    }
                    var html = '';
                    var cur = $('#ContractorsHidden').val();
                    data.forEach(function(item) {
                        var sel = (item.display === cur) ? ' cs-selected' : '';
                        html += '<div class="cs-option' + sel + '" data-cp="' + escHtml(item.display) + '">' +
                                '<i class="fas fa-building text-muted me-2"></i>' + escHtml(item.display) + '</div>';
                    });
                    $('#cpList').html(html);
                })
                .catch(function(err) {
                    clearTimeout(timeout);
                    console.error('loadCp error:', err);
                    var msg = err.name === 'AbortError' ? 'Превышено время ожидания' : ('Ошибка: ' + err.message);
                    $('#cpList').html('<div class="cs-option cs-no-results text-danger">' + escHtml(msg) + '</div>');
                });
        }

        $('#projectForm').on('submit', function (e) {
            validateDates();
            if ($('.date-error').length > 0) {
                e.preventDefault();
                $('html, body').animate({ scrollTop: $('.date-error').first().offset().top - 100 }, 400);
            }
        });
    });

    function validateDates() {
        var start   = $('#StartDate').val();
        var planned = $('#PlannedEndDate').val();
        var actual  = $('#ActualEndDate').val();

        clearDateError('PlannedEndDate');
        clearDateError('ActualEndDate');

        if (!start) return;
        if (planned && planned < start)
            showDateError('PlannedEndDate', 'Плановая дата не может быть раньше даты начала');
        if (actual && actual < start)
            showDateError('ActualEndDate', 'Фактическая дата не может быть раньше даты начала');
    }

    function showDateError(fieldId, msg) {
        var field = $('#' + fieldId);
        field.addClass('is-invalid');
        if (!field.closest('.input-group').next('.date-error').length)
            field.closest('.input-group').after('<span class="text-danger small date-error">' + msg + '</span>');
    }

    function clearDateError(fieldId) {
        $('#' + fieldId).removeClass('is-invalid')
            .closest('.input-group').next('.date-error').remove();
    }
    </script>
}
