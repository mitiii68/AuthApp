                document.getElementById('docTrigger').classList.remove('open');
                document.getElementById('docDropdown').classList.remove('open');
            }
        });

        function toggleDoc(el) {
            const id = parseInt(el.dataset.id);
            const cb = el.querySelector('input[type=checkbox]');
            if (selectedDocIds.has(id)) { selectedDocIds.delete(id); el.classList.remove('selected'); cb.checked = false; }
            else                        { selectedDocIds.add(id);    el.classList.add('selected');    cb.checked = true;  }
            renderDocChips(); syncDocHidden();
        }

        function removeDocChip(e, id) {
            e.stopPropagation();
            selectedDocIds.delete(id);
            const opt = document.querySelector('#docList .multi-picker-option[data-id="' + id + '"]');
            if (opt) { opt.classList.remove('selected'); opt.querySelector('input[type=checkbox]').checked = false; }
            renderDocChips(); syncDocHidden();
        }

        function renderDocChips() {
            const container   = document.getElementById('docChips');
            const placeholder = document.getElementById('docPlaceholder');
            container.querySelectorAll('.multi-picker-chip').forEach(c => c.remove());
            if (selectedDocIds.size === 0) { placeholder.style.display = ''; return; }
            placeholder.style.display = 'none';
            selectedDocIds.forEach(id => {
                const opt = document.querySelector('#docList .multi-picker-option[data-id="' + id + '"]');
                if (!opt) return;
                const chip = document.createElement('span');
