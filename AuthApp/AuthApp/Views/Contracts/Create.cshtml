                        const list = document.getElementById('docList');
                           if (data.length === 0) {
                list.innerHTML = '<div class="multi-picker-empty">Нет файлов с тегом «Договор»</div>';
                return;
            }
            list.innerHTML = '';
            data.forEach(f => {
                const div = document.createElement('div');
                div.className = 'multi-picker-option' + (selectedDocIds.has(f.id) ? ' selected' : '');
                div.dataset.id   = f.id;
                div.dataset.name = f.name;
                div.innerHTML = `<input type="checkbox" tabindex="-1" ${selectedDocIds.has(f.id) ? 'checked' : ''}/><span>${f.name}</span>`;
