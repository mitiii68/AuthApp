        function filterDocs(query) {
                const q = query.toLowerCase();
            document.querySelectorAll('#docList .multi-picker-option').forEach(el => {
                el.style.display = el.dataset.name.toLowerCase().includes(q) ? '' : 'none';
            });
            }
                async function uploadNewDoc() {
            const fileInput = document.getElementById('newDocFile');
            const status    = document.getElementById('uploadStatus');
            if (!fileInput.files[0]) { status.textContent = 'Выберите файл'; status.style.color = 'var(--danger)'; return; }

            status.textContent = 'Загрузка...';
            status.style.color = 'var(--text-sub)';

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            const res  = await fetch('/Contracts/UploadContractFile', { method: 'POST', body: formData });
            const data = await res.json();

            if (data.success) {
                status.textContent = 'Файл загружен и прикреплён!';
                status.style.color = '#2f9e44';
                fileInput.value = '';

                const list = document.getElementById('docList');
                const div  = document.createElement('div');
                div.className    = 'multi-picker-option selected';
                div.dataset.id   = data.id;
                div.dataset.name = data.name;
                div.innerHTML    = `<input type="checkbox" tabindex="-1" checked/><span>${data.name}</span>`;
                div.onclick      = () => toggleDoc(div);
                list.appendChild(div);

                selectedDocIds.add(data.id);
                renderDocChips();
                syncDocHidden();
            } else {
                status.textContent = '❌ ' + data.message;
                status.style.color = 'var(--danger)';
            }
        }

        loadDocs();
</script>
