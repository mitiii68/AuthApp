@model AuthApp.Models.Contract

<style>
    .approval-section { margin-top: 0; }

    .approval-doc-block {
        border: 1.5px solid var(--border); border-radius: 12px;
        margin-bottom: 14px; overflow: hidden;
        transition: box-shadow .15s;
    }
    .approval-doc-block:hover { box-shadow: 0 4px 20px rgba(59,91,219,.09); }

    .approval-doc-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 13px 18px; background: var(--surface-2);
        border-bottom: 1.5px solid var(--border); gap: 12px; flex-wrap: wrap;
    }
    .approval-doc-title {
        display: flex; align-items: center; gap: 9px;
        font-size: 13.5px; font-weight: 800; color: var(--text);
    }
    .adoc-icon {
        width: 30px; height: 30px; border-radius: 7px;
        background: var(--accent-light); color: var(--accent);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .approval-doc-actions { display: flex; gap: 8px; align-items: center; }

    .abadge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
    }
    .abadge-dot { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }
    .abadge-draft      { background: #f1f3f5; color: #6b7280; }
    .abadge-draft .abadge-dot { background: #9ca3af; }
    .abadge-inapproval { background: #fff3bf; color: #b36a00; }
    .abadge-inapproval .abadge-dot { background: #b36a00; }
    .abadge-approved   { background: #d3f9d8; color: #1a7f37; }
    .abadge-approved .abadge-dot { background: #1a7f37; }
    .abadge-rejected   { background: #fff0f0; color: var(--danger, #e03131); }
    .abadge-rejected .abadge-dot { background: var(--danger, #e03131); }

    .approval-ok-bar {
        display: flex; align-items: center; gap: 7px;
        padding: 7px 18px; background: #f0fdf4;
        border-bottom: 1px solid #bbf7d0;
        font-size: 12px; font-weight: 700; color: #1a7f37;
    }

    .approval-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .approval-table th {
        padding: 9px 14px; text-align: left;
        font-size: 10px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .07em; color: var(--text-sub);
        background: var(--surface-2); border-bottom: 1.5px solid var(--border);
        white-space: nowrap;
    }
    .approval-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    .approval-table tr:last-child td { border-bottom: none; }
    .approval-table tr:hover td { background: #f4f6ff; }

    .ap-cell { display: flex; align-items: center; gap: 8px; }
    .ap-avatar {
        width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
        background: var(--accent-light, #e7ecfd); color: var(--accent, #3b5bdb);
        font-size: 11px; font-weight: 800;
        display: flex; align-items: center; justify-content: center;
    }
    .ap-name { font-weight: 700; font-size: 13px; }
    .ap-pos  { font-size: 11px; color: var(--text-sub); margin-top: 1px; }

    .ast-pending  .ast-badge { background: #fff3bf; color: #b36a00; }
    .ast-approved .ast-badge { background: #d3f9d8; color: #1a7f37; }
    .ast-rejected .ast-badge { background: #fff0f0; color: #e03131; }
    .ast-badge {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 3px 9px; border-radius: 20px; font-size: 11px; font-weight: 700;
    }

    .ap-order {
        width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
        background: var(--border); color: var(--text-sub);
        font-size: 10px; font-weight: 800;
        display: flex; align-items: center; justify-content: center;
    }
    .ap-order.done   { background: #d3f9d8; color: #1a7f37; }
    .ap-order.active { background: var(--accent-light, #e7ecfd); color: var(--accent, #3b5bdb); }
    .ap-order.fail   { background: #fff0f0; color: #e03131; }

    .ap-date { font-size: 11.5px; color: var(--text-sub); white-space: nowrap; }
    .ap-date.set { color: var(--text); font-weight: 600; }
    .ap-comment { font-size: 11.5px; color: var(--text-sub); max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ap-comment.set { color: var(--text); font-style: italic; }

    .approval-empty { padding: 16px 18px; font-size: 13px; color: var(--text-sub); font-weight: 600; }

    .btn-success { background: #2f9e44; color: #fff; }
    .btn-success:hover { background: #276c39; }
    .btn-danger  { background: #e03131; color: #fff; }
    .btn-danger:hover  { background: #b52a2a; }
    .btn-sm { padding: 5px 12px; font-size: 12px; }

    .ap-modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(15,20,50,.45); z-index: 2000;
        align-items: center; justify-content: center;
        backdrop-filter: blur(2px);
    }
    .ap-modal-overlay.open { display: flex; }
    .ap-modal-box {
        background: #fff; border-radius: 16px; padding: 26px;
        width: 420px; max-width: 95vw;
        box-shadow: 0 12px 50px rgba(0,0,0,.2);
        animation: apModalIn .17s ease;
    }
    @@keyframes apModalIn { from { opacity:0; transform:scale(.94) translateY(8px); } to { opacity:1; transform:none; } }
    .ap-modal-box h3 { font-size: 16px; font-weight: 800; margin-bottom: 4px; }
    .ap-modal-box p  { font-size: 12.5px; color: var(--text-sub); margin-bottom: 14px; }
    .ap-modal-box textarea {
        width: 100%; border: 1.5px solid var(--border); border-radius: 10px;
        padding: 10px 13px; font-family: var(--font); font-size: 13.5px;
        resize: vertical; min-height: 80px; outline: none;
    }
    .ap-modal-box textarea:focus { border-color: var(--accent, #3b5bdb); box-shadow: 0 0 0 3px var(--accent-light, #e7ecfd); }
    .ap-modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 14px; }
    .ap-notif-btn {
        position: relative; background: none; border: 1.5px solid var(--border);
        border-radius: 9px; padding: 6px 10px; cursor: pointer; display: flex;
        align-items: center; gap: 6px; font-family: var(--font);
        font-size: 12px; font-weight: 700; color: var(--text-sub);
        transition: all .15s;
    }
    .ap-notif-btn:hover { background: var(--accent-light); border-color: var(--accent); color: var(--accent); }
    .ap-notif-btn.allowed { color: var(--accent); border-color: var(--accent); background: var(--accent-light); }
    .ap-notif-btn.denied  { opacity: .5; cursor: not-allowed; }
    .ap-notif-badge {
        position: absolute; top: -6px; right: -6px;
        width: 18px; height: 18px; border-radius: 50%;
        background: #e03131; color: #fff;
        font-size: 10px; font-weight: 800;
        display: flex; align-items: center; justify-content: center;
        border: 2px solid #fff;
        animation: apBadgePop .3s ease;
    }
    @@keyframes apBadgePop { from { transform: scale(0); } to { transform: scale(1); } }

    .ap-notif-panel {
        position: fixed; top: 60px; right: 20px; z-index: 1900;
        width: 340px; max-width: 95vw;
        background: #fff; border: 1.5px solid var(--border);
        border-radius: 14px; box-shadow: 0 8px 40px rgba(0,0,0,.14);
        display: none; flex-direction: column; overflow: hidden;
        animation: apPanelIn .18s ease;
    }
    .ap-notif-panel.open { display: flex; }
    @@keyframes apPanelIn { from { opacity:0; transform: translateY(-8px) scale(.97); } to { opacity:1; transform:none; } }

    .ap-notif-panel-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 16px 10px; border-bottom: 1.5px solid var(--border);
    }
    .ap-notif-panel-title { font-size: 14px; font-weight: 800; }
    .ap-notif-panel-clear {
        font-size: 12px; font-weight: 700; color: var(--text-sub);
        background: none; border: none; cursor: pointer; padding: 3px 7px;
        border-radius: 6px; font-family: var(--font);
    }
    .ap-notif-panel-clear:hover { background: var(--surface-2); color: var(--danger); }

    .ap-notif-list { max-height: 360px; overflow-y: auto; }
    .ap-notif-item {
        display: flex; gap: 10px; padding: 12px 16px;
        border-bottom: 1px solid var(--border); cursor: pointer;
        transition: background .1s;
    }
    .ap-notif-item:last-child { border-bottom: none; }
    .ap-notif-item:hover { background: #f4f6ff; }
    .ap-notif-item.unread { background: var(--accent-light); }
    .ap-notif-item.unread:hover { background: #d4dcf9; }
    .ap-notif-icon {
        width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px;
    }
    .ap-notif-icon.started  { background: #fff3bf; }
    .ap-notif-icon.approved { background: #d3f9d8; }
    .ap-notif-icon.decided  { background: var(--accent-light); }
    .ap-notif-body { flex: 1; min-width: 0; }
    .ap-notif-title-text { font-size: 13px; font-weight: 700; }
    .ap-notif-msg   { font-size: 12px; color: var(--text-sub); margin-top: 2px; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ap-notif-time  { font-size: 11px; color: var(--text-sub); margin-top: 4px; }
    .ap-notif-empty { padding: 28px 16px; text-align: center; font-size: 13px; color: var(--text-sub); font-weight: 600; }
    .ap-always-badge {
        display: inline-flex; align-items: center; gap: 3px;
        padding: 2px 7px; border-radius: 20px;
        background: #e7ecfd; color: #3b5bdb;
        font-size: 10px; font-weight: 800;
        white-space: nowrap; flex-shrink: 0;
        border: 1px solid rgba(59,91,219,.2);
    }

    .ap-realtime-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: #9ca3af; display: inline-block;
        margin-right: 4px; flex-shrink: 0;
        transition: background .3s;
    }
    .ap-realtime-dot.connected { background: #2f9e44; animation: apDotPulse 2s ease infinite; }
    @@keyframes apDotPulse {
        0%, 100% { opacity: 1; }
        50%  { opacity: .4; }
    }

    .ap-toast-wrap {
        position: fixed; bottom: 24px; right: 24px; z-index: 3000;
        display: flex; flex-direction: column; gap: 8px; pointer-events: none;
    }
    .ap-toast {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 12px 16px; border-radius: 12px;
        background: #fff; border: 1.5px solid var(--border);
        box-shadow: 0 6px 28px rgba(0,0,0,.13);
        font-family: var(--font); font-size: 13px;
        animation: apToastIn .25s ease; pointer-events: auto;
        max-width: 340px;
    }
    .ap-toast-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
    .ap-toast-title { font-weight: 800; font-size: 13px; }
    .ap-toast-msg   { font-size: 12px; color: var(--text-sub); margin-top: 2px; }
    .ap-toast-close {
        background: none; border: none; cursor: pointer; color: var(--text-sub);
        font-size: 14px; padding: 0 0 0 8px; align-self: flex-start; line-height: 1;
    }
    @@keyframes apToastIn { from { opacity:0; transform: translateY(14px) scale(.95); } to { opacity:1; transform:none; } }
</style>

<div class="form-card approval-section">
    <input type="hidden" id="apCurrentUserId" value="@Context.Session.GetString("UserId")" />
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px">
        <h2 style="margin:0">Согласование документов</h2>
        <div style="display:flex;align-items:center;gap:8px">
            <span class="ap-realtime-dot" id="apRealtimeDot" title="Статус подключения"></span>
            <button class="ap-notif-btn" id="apNotifBtn" onclick="apTogglePanel()" title="Уведомления">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                Уведомления
            </button>
        </div>
    </div>
    <div id="approvalContainer">
        <div style="padding:20px;color:var(--text-sub);font-size:13px;font-weight:600;">⏳ Загрузка...</div>
    </div>
</div>

<div class="ap-notif-panel" id="apNotifPanel">
    <div class="ap-notif-panel-header">
        <span class="ap-notif-panel-title">🔔 Уведомления</span>
        <button class="ap-notif-panel-clear" onclick="apClearNotifs()">Очистить всё</button>
    </div>
    <div class="ap-notif-list" id="apNotifList">
        <div class="ap-notif-empty">Нет уведомлений</div>
    </div>
</div>

<div class="ap-modal-overlay" id="apDecideModal">
    <div class="ap-modal-box">
        <h3 id="apDecideTitle">Принять решение</h3>
        <p id="apDecideSub"></p>
        <textarea id="apDecideComment" placeholder="Комментарий (необязательно)..."></textarea>
        <div class="ap-modal-actions">
            <button class="btn btn-ghost btn-sm" onclick="apCloseModal()">Отмена</button>
            <button class="btn btn-sm" id="apDecideConfirmBtn" onclick="apConfirmDecision()">Подтвердить</button>
        </div>
    </div>
</div>

<div class="ap-toast-wrap" id="apToastWrap"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
const contractId = @Model.Id;

let apPendingApprovalId = null;
let apPendingDocumentId = null;
let apPendingDecision   = null;
const AP_NOTIF_KEY = 'ap_notifications_c' + contractId;
let apNotifications = JSON.parse(localStorage.getItem(AP_NOTIF_KEY) || '[]');
let apPanelOpen = false;

function apSaveNotifs() {
    if (apNotifications.length > 50) apNotifications = apNotifications.slice(-50);
    localStorage.setItem(AP_NOTIF_KEY, JSON.stringify(apNotifications));
}

function apUnreadCount() {
    return apNotifications.filter(n => !n.read).length;
}

function apUpdateBadge() {
    const btn   = document.getElementById('apNotifBtn');
    const count = apUnreadCount();
    let badge   = btn.querySelector('.ap-notif-badge');
    if (count > 0) {
        if (!badge) { badge = document.createElement('span'); badge.className = 'ap-notif-badge'; btn.appendChild(badge); }
        badge.textContent = count > 99 ? '99+' : count;
    } else {
        badge?.remove();
    }
}

function apRenderNotifList() {
    const list = document.getElementById('apNotifList');
    if (!apNotifications.length) {
        list.innerHTML = '<div class="ap-notif-empty">Нет уведомлений</div>';
        return;
    }
    const iconMap = { started: '🚀', approved: '✅', decided: '📋', approval: '🔔' };
    list.innerHTML = [...apNotifications].reverse().map((n, i) => {
        const ri = apNotifications.length - 1 - i;
        const timeStr = new Date(n.sentAt).toLocaleString('ru', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' });
        const iconCls = n.type === 'started' ? 'started' : n.type === 'approved' ? 'approved' : 'decided';
        return `<div class="ap-notif-item ${n.read ? '' : 'unread'}" onclick="apReadNotif(${ri})">
            <div class="ap-notif-icon ${iconCls}">${iconMap[n.type] || '🔔'}</div>
            <div class="ap-notif-body">
                <div class="ap-notif-title-text">${apEsc(n.title)}</div>
                <div class="ap-notif-msg" title="${apEsc(n.message)}">${apEsc(n.message)}</div>
                <div class="ap-notif-time">${timeStr}</div>
            </div>
        </div>`;
    }).join('');
}

function apReadNotif(idx) {
    if (apNotifications[idx]) apNotifications[idx].read = true;
    apSaveNotifs();
    apUpdateBadge();
    apRenderNotifList();
}

function apClearNotifs() {
    apNotifications = [];
    apSaveNotifs();
    apUpdateBadge();
    apRenderNotifList();
}

function apTogglePanel() {
    apPanelOpen = !apPanelOpen;
    const panel = document.getElementById('apNotifPanel');
    panel.classList.toggle('open', apPanelOpen);
    if (apPanelOpen) {
        apNotifications.forEach(n => n.read = true);
        apSaveNotifs();
        apUpdateBadge();
        apRenderNotifList();
    }
}

document.addEventListener('click', e => {
    if (apPanelOpen && !e.target.closest('#apNotifPanel') && !e.target.closest('#apNotifBtn')) {
        apPanelOpen = false;
        document.getElementById('apNotifPanel').classList.remove('open');
    }
});

function apShowToast(title, message, type) {
    const wrap = document.getElementById('apToastWrap');
    const el   = document.createElement('div');
    const iconMap = { started: '🚀', approved: '✅', decided: '📋', approval: '🔔' };
    el.className = 'ap-toast';
    el.innerHTML = `
        <span class="ap-toast-icon">${iconMap[type] || '🔔'}</span>
        <div style="flex:1">
            <div class="ap-toast-title">${apEsc(title)}</div>
            <div class="ap-toast-msg">${apEsc(message)}</div>
        </div>
        <button class="ap-toast-close" onclick="this.closest('.ap-toast').remove()">✕</button>`;
    wrap.appendChild(el);
    setTimeout(() => {
        el.style.opacity = '0'; el.style.transition = 'opacity .3s';
        setTimeout(() => el.remove(), 320);
    }, 5000);
}

function apRequestPushPermission() {
    if (!('Notification' in window)) return;
    if (Notification.permission === 'granted') {
        document.getElementById('apNotifBtn').classList.add('allowed');
        return;
    }
    if (Notification.permission === 'denied') {
        document.getElementById('apNotifBtn').classList.add('denied');
        return;
    }
    Notification.requestPermission().then(perm => {
        if (perm === 'granted') document.getElementById('apNotifBtn').classList.add('allowed');
        else                     document.getElementById('apNotifBtn').classList.add('denied');
    });
}

function apBrowserPush(title, body, url) {
    if (Notification.permission !== 'granted') return;
    if (document.hasFocus()) return; 
    const n = new Notification(title, {
        body,
        icon: '/favicon.ico',
        badge: '/favicon.ico'
    });
    if (url) n.onclick = () => { window.focus(); window.location.href = url; };
}

let apConnection = null;

function apInitSignalR() {
    const dot = document.getElementById('apRealtimeDot');
    apConnection = new signalR.HubConnectionBuilder()
    .withUrl('/hubs/approvalNotification')
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .configureLogging(signalR.LogLevel.Warning)
        .build();

    apConnection.on('ReceiveNotification', (notif) => {
        apNotifications.push({ ...notif, read: false });
        apSaveNotifs();
        apUpdateBadge();
        if (apPanelOpen) apRenderNotifList();

        apShowToast(notif.title, notif.message, notif.type);

        apBrowserPush(notif.title, notif.message, notif.url);

        if (['started', 'decided', 'approved'].includes(notif.type)) {
            setTimeout(loadApprovals, 800);
        }
    });

    apConnection.onreconnecting(() => { dot.className = 'ap-realtime-dot'; dot.title = 'Переподключение...'; });
    apConnection.onreconnected(() => {
        dot.className = 'ap-realtime-dot connected';
        dot.title = 'Подключено';
        apJoinUserGroup();
    });
    apConnection.onclose(() => { dot.className = 'ap-realtime-dot'; dot.title = 'Отключено'; });

    apConnection.start()
        .then(() => {
            dot.className = 'ap-realtime-dot connected';
            dot.title = 'Подключено';
            apJoinUserGroup();
        })
        .catch(e => {
            console.warn('SignalR connection failed:', e);
            dot.title = 'Ошибка подключения';
        });
}
    async function apJoinUserGroup() {
    try {
    const userId = document.getElementById('apCurrentUserId')?.value;
    if (userId) await apConnection.invoke('Join', userId);
    } catch(e) {
    console.warn('SignalR Join failed:', e);
    }
    }
async function loadApprovals() {
    const container = document.getElementById('approvalContainer');
    try {
        const res  = await fetch(`/api/contracts/${contractId}/approval-overview`);
        if (!res.ok) throw new Error(res.status);
        const docs = await res.json();
        container.innerHTML = docs.length
            ? docs.map(apBuildBlock).join('')
            : '<div class="approval-empty">Нет прикреплённых документов.</div>';
    } catch {
        container.innerHTML = '<div class="approval-empty" style="color:#e03131">Не удалось загрузить данные согласования.</div>';
    }
}

function apBuildBlock(doc) {
    const bMap = {
        0: ['abadge-draft','Черновик'],
        1: ['abadge-inapproval','На согласовании'],
        2: ['abadge-approved','Согласован'],
        3: ['abadge-rejected','Отклонён']
    };
    const [bcls, btxt] = bMap[doc.approvalStatus] || bMap[0];
    const canStart = doc.approvalStatus === 0 || doc.approvalStatus === 3;
    const isParallel = doc.rows.every(r => r.orderIndex === 0);

    const approvedBar = doc.approvedAt
        ? `<div class="approval-ok-bar">
               <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
               Согласован: ${new Date(doc.approvedAt).toLocaleString('ru')}
           </div>` : '';

    const rows = doc.rows.length ? doc.rows.map(r => {
        const initials = (r.fullName ?? '?').split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase();
        const stCls  = { 0:'ast-pending', 1:'ast-approved', 2:'ast-rejected' }[r.status];
        const stTxt  = { 0:'Ожидает', 1:'Согласован', 2:'Отклонён' }[r.status];

        const orderCls = r.status===1 ? 'done' : r.status===2 ? 'fail'
            : (!isParallel && r.orderIndex === doc.rows.filter(x=>x.status===1).length ? 'active' : '');
        const orderEl  = isParallel ? '' : `<div class="ap-order ${orderCls}">${r.orderIndex+1}</div>`;

        const vAt = r.viewedAt  ? `<span class="ap-date set">${new Date(r.viewedAt).toLocaleString('ru')}</span>`  : `<span class="ap-date">—</span>`;
        const dAt = r.decidedAt ? `<span class="ap-date set">${new Date(r.decidedAt).toLocaleString('ru')}</span>` : `<span class="ap-date">—</span>`;
        const cmt = r.comment   ? `<span class="ap-comment set" title="${apEsc(r.comment)}">${apEsc(r.comment)}</span>` : `<span class="ap-comment">—</span>`;
        const alwaysBadge = r.isAlwaysInApproval
            ? `<span class="ap-always-badge" title="Всегда в согласовании">
                   <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 3.9 2.4-7.4L2 9.4h7.6z"/></svg>
                   обязательный
               </span>`
            : '';

        const myRow = r.isCurrentUser && r.status === 0 && doc.approvalStatus === 1;
        const btns  = myRow
            ? `<div style="display:flex;gap:5px;white-space:nowrap">
                   <button class="btn btn-success btn-sm" onclick="apOpenDecide(${r.approvalId},${doc.contractDocumentId},1,'${apEsc(r.fullName)}')">✓ Согласовать</button>
                   <button class="btn btn-danger  btn-sm" onclick="apOpenDecide(${r.approvalId},${doc.contractDocumentId},2,'${apEsc(r.fullName)}')">✗ Отклонить</button>
               </div>` : '';

        return `<tr>
            <td>
                <div class="ap-cell">
                    ${orderEl}
                    <div class="ap-avatar">${initials}</div>
                    <div>
                        <div class="ap-name" style="display:flex;align-items:center;gap:5px;flex-wrap:wrap">
                            ${apEsc(r.fullName ?? '—')} ${alwaysBadge}
                        </div>
                        <div class="ap-pos">${apEsc(r.position ?? '—')}</div>
                    </div>
                </div>
            </td>
            <td class="${stCls}"><span class="ast-badge">${stTxt}</span></td>
            <td>${vAt}</td>
            <td>${dAt}</td>
            <td>${cmt}</td>
            <td>${btns}</td>
        </tr>`;
    }).join('') : '';

    const table = doc.rows.length
        ? `<table class="approval-table">
               <thead><tr>
                   <th>ФИО / Должность</th><th>Статус</th>
                   <th>Просмотрен</th><th>Решение</th><th>Комментарий</th><th></th>
               </tr></thead>
               <tbody>${rows}</tbody>
           </table>`
        : '<div class="approval-empty">Согласование не запущено.</div>';

    const startBtn = canStart
        ? `<button class="btn btn-primary btn-sm" onclick="apStartApproval(${doc.contractDocumentId})">
               <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
               Запустить
           </button>` : '';

    return `<div class="approval-doc-block">
        <div class="approval-doc-header">
            <div class="approval-doc-title">
                <div class="adoc-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                ${apEsc(doc.documentName ?? 'Документ #' + doc.contractDocumentId)}
            </div>
            <div class="approval-doc-actions">
                <span class="abadge ${bcls}"><span class="abadge-dot"></span>${btxt}</span>
                ${startBtn}
            </div>
        </div>
        ${approvedBar}
        ${table}
    </div>`;
}
async function apStartApproval(docId) {
    if (!confirm('Запустить согласование для всех участников?')) return;
    const res = await fetch(`/api/contract-documents/${docId}/approvals/start`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({})
    });
    if (res.ok) { await loadApprovals(); }
    else { alert('Ошибка при запуске согласования'); }
}

function apOpenDecide(approvalId, documentId, decision, name) {
    apPendingApprovalId = approvalId;
    apPendingDocumentId = documentId;
    apPendingDecision   = decision;
    document.getElementById('apDecideTitle').textContent = decision === 1 ? 'Согласовать документ' : 'Отклонить документ';
    document.getElementById('apDecideSub').textContent   = `Участник: ${name}`;
    document.getElementById('apDecideComment').value = '';
    const btn = document.getElementById('apDecideConfirmBtn');
    btn.className = 'btn btn-sm ' + (decision === 1 ? 'btn-success' : 'btn-danger');
    btn.textContent = decision === 1 ? 'Согласовать' : 'Отклонить';
    document.getElementById('apDecideModal').classList.add('open');
}
function apCloseModal() {
    document.getElementById('apDecideModal').classList.remove('open');
    apPendingApprovalId = apPendingDocumentId = apPendingDecision = null;
}
async function apConfirmDecision() {
    const comment = document.getElementById('apDecideComment').value;
    await fetch(`/api/contract-documents/${apPendingDocumentId}/approvals/${apPendingApprovalId}/view`, { method: 'POST' });
    const res = await fetch(`/api/contract-documents/${apPendingDocumentId}/approvals/${apPendingApprovalId}/decide`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ decision: apPendingDecision, comment })
    });
    apCloseModal();
    if (res.ok) { await loadApprovals(); }
    else { alert('Ошибка при сохранении решения'); }
}

function apEsc(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

apUpdateBadge();
apRenderNotifList();
apRequestPushPermission();
apInitSignalR();
loadApprovals();
</script>
