@model AuthApp.Models.User

@{
    ViewData["Title"] = "Редактирование профиля";
    var lat = Model.Latitude ?? 49.9483;
    var lng = Model.Longitude ?? 82.6170;
    var positions = ViewBag.Positions as List<AuthApp.Models.Position> ?? new List<AuthApp.Models.Position>();
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .edit-page {
        max-width: 860px;
        margin: 32px auto;
        padding: 0 16px;
    }

    .edit-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .edit-header {
        padding: 20px 28px;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
    }

    .edit-title {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .edit-body {
        padding: 28px;
    }

    .section-title {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #6b7280;
        margin: 0 0 14px;
    }

    .section-divider {
        border: none;
        border-top: 1px solid #e5e7eb;
        margin: 24px 0;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #374151;
        }

            .form-group label span.req {
                color: #ef4444;
            }

    .form-control {
        height: 40px;
        padding: 0 12px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font-size: 14px;
        color: #1f2937;
        background: #fff;
        outline: none;
        transition: border-color .15s;
        font-family: inherit;
    }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,.1);
        }

    #map {
        height: 280px;
        border-radius: 12px;
        border: 1px solid #d1d5db;
        margin-top: 16px;
    }

    .map-hint {
        font-size: 12px;
        color: #9ca3af;
        margin-top: 6px;
    }

    .toggle-section {
        background: #f0f4ff;
        border: 1.5px solid #c7d4f8;
        border-radius: 12px;
        padding: 18px 22px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .toggle-section-text { flex: 1; }

    .toggle-section-label {
        font-size: 14px;
        font-weight: 700;
        color: #1e3a8a;
        margin-bottom: 4px;
    }

    .toggle-section-desc {
        font-size: 12.5px;
        color: #4b68c7;
        line-height: 1.5;
    }

    .toggle-switch {
        position: relative;
        width: 46px;
        height: 26px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .toggle-switch input { opacity: 0; width: 0; height: 0; }

    .toggle-slider {
        position: absolute; inset: 0;
        background: #d1d5db;
        border-radius: 26px;
        cursor: pointer;
        transition: background .2s;
    }

    .toggle-slider::before {
        content: '';
        position: absolute;
        width: 20px; height: 20px;
        left: 3px; top: 3px;
        background: #fff;
        border-radius: 50%;
        transition: transform .2s;
        box-shadow: 0 1px 4px rgba(0,0,0,.2);
    }

    .toggle-switch input:checked + .toggle-slider { background: #2563eb; }
    .toggle-switch input:checked + .toggle-slider::before { transform: translateX(20px); }

    .btn-row {
        display: flex;
        gap: 10px;
        margin-top: 28px;
    }

    .btn-save {
        height: 42px;
        padding: 0 28px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-save:hover {
            background: #1d4ed8;
        }

    .btn-cancel {
        height: 42px;
        padding: 0 24px;
        background: #f3f4f6;
        color: #374151;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all .15s;
    }

        .btn-cancel:hover {
            background: #e5e7eb;
        }
</style>

<div class="edit-page">
    <div class="edit-card">
        <div class="edit-header">
            <h2 class="edit-title">Редактирование профиля — @Model.FullName</h2>
        </div>
        <div class="edit-body">
            <form method="post" asp-action="EditProfile" asp-controller="Users" asp-route-userId="@Model.UserId">
                <input type="hidden" name="userId" value="@Model.UserId" />
                <p class="section-title">Должность</p>
                <div class="form-grid" style="margin-bottom:8px;">
                    <div class="form-group">
                        <label>Должность пользователя</label>
                        <select name="positionId" class="form-control">
                            <option value="">— Не назначена —</option>
                            @foreach (var pos in positions)
                            {
                                if (Model.PositionId == pos.Id)
                                {
                                    <option value="@pos.Id" selected>@pos.Name</option>
                                }
                                else
                                {
                                    <option value="@pos.Id">@pos.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <hr class="section-divider" />

                <p class="section-title">Местоположение</p>

                <div class="form-grid">
                    <div class="form-group">
                        <label>Район <span class="req">*</span></label>
                        <select name="district" class="form-control">
                            <option value="">— Выберите район —</option>
                            @{ var districts = new[] { "Октябрьский", "Ульбинский", "Аблакетский", "Новопокровский" }; }
                            @foreach (var d in districts)
                            {
                                if (Model.District == d) { <option value="@d" selected>@d</option> }
                                else { <option value="@d">@d</option> }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Сельский округ</label>
                        <select name="ruralDistrict" class="form-control">
                            <option value="">— Выберите округ —</option>
                            @{ var ruralDistricts = new[] { "Согринский", "Предгорненский" }; }
                            @foreach (var rd in ruralDistricts)
                            {
                                if (Model.RuralDistrict == rd) { <option value="@rd" selected>@rd</option> }
                                else { <option value="@rd">@rd</option> }
                            }
                        </select>
                    </div>
                </div>

                <div class="form-grid" style="margin-top:16px;">
                    <div class="form-group">
                        <label>Населённый пункт <span class="req">*</span></label>
                        <select name="settlement" class="form-control">
                            <option value="">— Выберите —</option>
                            @{ var settlements = new[] { "Усть-Каменогорск", "Согра", "Предгорное" }; }
                            @foreach (var s in settlements)
                            {
                                if (Model.Settlement == s) { <option value="@s" selected>@s</option> }
                                else { <option value="@s">@s</option> }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Улица</label>
                        <input class="form-control" type="text" name="street"
                               value="@Model.Street" placeholder="Введите улицу" />
                    </div>
                </div>

                <div class="form-grid-3" style="margin-top:16px;">
                    <div class="form-group">
                        <label>Дом</label>
                        <input class="form-control" type="text" name="house"
                               value="@Model.House" placeholder="№ дома" />
                    </div>
                    <div class="form-group">
                        <label>Широта</label>
                        <input class="form-control" type="text" id="latInput" name="latitude"
                               value="@Model.Latitude" placeholder="49.9483" />
                    </div>
                    <div class="form-group">
                        <label>Долгота</label>
                        <input class="form-control" type="text" id="lngInput" name="longitude"
                               value="@Model.Longitude" placeholder="82.6170" />
                    </div>
                </div>

                <div id="map"></div>
                <p class="map-hint">Кликните по карте чтобы указать точное местоположение</p>

                <hr class="section-divider" />

                <p class="section-title">Согласование</p>
                <div class="toggle-section">
                    <div class="toggle-section-text">
                        <div class="toggle-section-label">Всегда добавлять в список согласования</div>
                        <div class="toggle-section-desc">
                            Пользователь будет автоматически включён в согласование по каждому договору
                            и получит уведомление при его создании или изменении.
                        </div>
                    </div>
                   
                    <input type="hidden" name="alwaysInApproval" value="false" />
                    <label class="toggle-switch" title="Всегда в согласовании">
                        <input type="checkbox" name="alwaysInApproval" value="true"
                               @(Model.AlwaysInApproval ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="btn-row">
                    <button type="submit" class="btn-save">Сохранить</button>
                    <a asp-action="Index" asp-controller="Users" class="btn-cancel">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var lat = @lat.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var lng = @lng.ToString(System.Globalization.CultureInfo.InvariantCulture);

    var map = L.map('map').setView([lat, lng], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    var marker = L.marker([lat, lng], { draggable: true }).addTo(map);

    function updateInputs(lt, ln) {
        document.getElementById('latInput').value = lt.toFixed(6);
        document.getElementById('lngInput').value = ln.toFixed(6);
    }

    marker.on('dragend', function(e) {
        var pos = marker.getLatLng();
        updateInputs(pos.lat, pos.lng);
    });

    map.on('click', function(e) {
        marker.setLatLng(e.latlng);
        updateInputs(e.latlng.lat, e.latlng.lng);
    });
</script>
